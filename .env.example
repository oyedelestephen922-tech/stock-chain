# ─── Network ────────────────────────────────────────────────────────────────
# Defaults below are Robinhood Chain mainnet (verified: chain ID 4663 / 0x1237).
VITE_CHAIN_ID=4663
VITE_CHAIN_NAME=Robinhood Chain
VITE_RPC_URL=https://rpc.mainnet.chain.robinhood.com
VITE_EXPLORER_URL=https://robinhoodchain.blockscout.com
VITE_NATIVE_SYMBOL=ETH

# ─── Market data ────────────────────────────────────────────────────────────
# Empty  = live exchange prices from the built-in /api routes (api/_lib/quotes.js).
# demo   = clearly-labelled placeholder data.
# A URL  = your own market API exposing
#          GET {URL}/markets  and  GET {URL}/markets/{symbol}/history?range=1D
# See src/services/marketData.js for the expected JSON shape.
# Never put a secret API key here: VITE_ variables are visible in the browser.
# Proxy paid APIs through your own backend (e.g. a Vercel serverless function).
VITE_MARKET_API_URL=

# ─── Alpaca market data (SERVER-SIDE ONLY: no VITE_ prefix, never sent to the browser)
# Get free keys: alpaca.markets → sign up → Paper Trading dashboard → API Keys → Generate.
# When both keys are set, prices come from Alpaca; otherwise Yahoo Finance is used.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# iex = free plan (real-time trades from the IEX exchange); sip = paid plan (all US exchanges)
ALPACA_FEED=iex
# Paper keys use paper-api; live-account keys use https://api.alpaca.markets
ALPACA_TRADING_URL=https://paper-api.alpaca.markets

# ─── Protocol backend (vaults + platform stats) ─────────────────────────────
VITE_PROTOCOL_API_URL=

# ─── Contracts (leave empty until deployed + verified) ──────────────────────
VITE_ROUTER_ADDRESS=
VITE_VAULT_FACTORY_ADDRESS=

# ─── Social (links only appear when set) ────────────────────────────────────
VITE_SOCIAL_X=
VITE_SOCIAL_DISCORD=
VITE_SOCIAL_TELEGRAM=
